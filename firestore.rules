rules_version = '2';

// =============================================================================
// Firestore Security Rules — boilerplate (next-forge fork)
//
// MODELO DE ACESSO
//   Todo acesso ao Firestore passa pela apps/api (guards no servidor →
//   repositórios), que se autentica com uma service account via firebase-admin
//   (getFirestoreAdmin() de @repo/auth/server). Como serviço confiável, ela
//   IGNORA estas regras — publicar a negação abaixo não afeta a API.
//   Nenhum cliente (browser) acessa o Firestore direto: o front fala só com a
//   API via @repo/sdk. Por isso a postura padrão aqui é NEGAR todo acesso
//   direto de clientes.
//
// ⚠️ ORDEM AO MIGRAR UM FORK QUE AINDA USE O CLIENT SDK NA API
//   Publique estas regras DEPOIS de a API rodar no Admin SDK; o inverso deixa
//   a API sem acesso. E o rollback correto é reverter o código da API primeiro:
//   republicar regras permissivas sem reverter reexpõe a base inteira.
//
// Deploy: `npx -y firebase-tools@latest deploy --only firestore:rules,firestore:indexes`
//   (o projeto alvo vem do .firebaserc; um fork usa --project <id> para não
//    reescrever esse arquivo versionado — ver docs/SETUP.md)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Negação padrão: nenhum cliente lê/escreve diretamente.
    // O backend (firebase-admin) ignora estas regras e continua operando.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // ALTERNATIVA (NÃO ativa) — só se um dia expor coleções direto ao cliente.
    //
    // ATENÇÃO ao modelo de dados: `entity.userId` guarda o ID do documento de
    // perfil do usuário (coleção `user`), NÃO o UID do Firebase Auth. A ponte
    // UID → perfil é resolvida na API (userRepository.findByReferenceId(uid)),
    // então regras "por dono" no cliente exigiriam ler o perfil aqui (custoso)
    // ou trocar o modelo. Por isso o acesso direto de cliente NÃO é recomendado.
    //
    // Exemplo ilustrativo (assumindo entity.userId == request.auth.uid):
    //   function isSignedIn() { return request.auth != null; }
    //   function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    //   match /entity/{entityId} {
    //     allow read, update, delete: if isOwner(resource.data.userId);
    //     allow create: if isSignedIn()
    //       && request.resource.data.userId == request.auth.uid;
    //   }
    // -------------------------------------------------------------------------
  }
}
