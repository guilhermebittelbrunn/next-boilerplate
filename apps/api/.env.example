# Server

# Firebase service account — required. It is how the API authenticates to Firestore
# (its database) and to Firebase Auth, so the API refuses to start without all three.
# Keep the newlines in the private key escaped as \n.
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Firebase Web API key — the API calls the Identity Toolkit REST endpoints (sign-in,
# sign-up) with it. Found under Project settings > General > Web API Key.
FIREBASE_WEB_API_KEY=""

# Comma-separated list of browser origins allowed to call the API. REQUIRED in
# production: the process refuses to start without it. Left empty outside production,
# the local front-ends below are assumed. There is no wildcard.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

RESEND_FROM=""
RESEND_TOKEN=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional. Without it, @repo/security degrades to a no-op: the public auth routes
# accept unlimited requests and the API says so once, at boot.
ARCJET_KEY=""

VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3002"

# Client
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
