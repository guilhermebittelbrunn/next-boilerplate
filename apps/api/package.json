{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:with-stripe": "concurrently \"npm:next\" \"npm:stripe\"",
    "next": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true npm run build",
    "test": "NODE_ENV=test vitest run",
    "stripe": "stripe listen --forward-to localhost:3002/webhooks/payments",
    "create-dev-admin": "node --env-file-if-exists=.env scripts/create-dev-admin.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/sdk": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/payments": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.8",
    "firebase": "^11.10.0",
    "next": "16.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "firebase-admin": "^13.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}
