# Server
RESEND_FROM=""
RESEND_TOKEN=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional. Without it, @repo/security degrades to a no-op.
ARCJET_KEY=""

VERCEL_PROJECT_PRODUCTION_URL=""

# Firebase service account — used to mint and verify the shared session cookie.
# Keep the newlines in the private key escaped as \n.
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Cross-app session cookie (SSO web <-> app). Leave SESSION_COOKIE_DOMAIN EMPTY in
# dev (localhost cookie is shared across ports). In prod set the registrable parent
# domain (e.g. "example.com"). Never a public suffix like vercel.app.
SESSION_COOKIE_DOMAIN=""
SESSION_COOKIE_MAX_AGE_DAYS=""

# Client
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_WEB_URL=""
NEXT_PUBLIC_DOCS_URL=""

# SEO identity (optional; neutral defaults are used when unset — each fork sets its own)
NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_APP_AUTHOR=""
NEXT_PUBLIC_APP_AUTHOR_URL=""
NEXT_PUBLIC_TWITTER_HANDLE=""

# Product model: "subscription" (operate in the app panel) | "simple" (operate in
# web, panel is admin-only). Default: subscription.
NEXT_PUBLIC_PRODUCT_MODE="subscription"
