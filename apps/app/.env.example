# Server

# Firebase service account — the proxy verifies the session cookie with it on every
# authenticated navigation. Keep the newlines in the private key escaped as \n.
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

RESEND_FROM=""
RESEND_TOKEN=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional. Without it, @repo/security degrades to a no-op.
ARCJET_KEY=""

VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3000"

# Cross-app session cookie (SSO web <-> app). Leave SESSION_COOKIE_DOMAIN EMPTY in
# dev (localhost cookie is shared across ports). In prod set the registrable parent
# domain (e.g. "example.com") so app.example.com + example.com share the session.
# Never a public suffix like vercel.app. MAX_AGE_DAYS: 0.0035–14, default 5.
SESSION_COOKIE_DOMAIN=""
SESSION_COOKIE_MAX_AGE_DAYS=""

# Client

# Firebase web app config — the browser signs in with it before the session cookie
# is minted. These are public by design; the security boundary is the rules and the API.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"

# Product model: "subscription" (operate in the app panel) | "simple" (operate in
# web, panel is admin-only). Default: subscription.
NEXT_PUBLIC_PRODUCT_MODE="subscription"
